# ─── Base de datos ───────────────────────────────────────────────
# Local: SQLite. Producción: postgres://usuario:clave@host:5432/base
DATABASE_URL="file:./dev.db"

# ─── Sitio ───────────────────────────────────────────────────────
# URL pública (se usa en los links de los emails)
SITE_URL="http://localhost:3000"
# Token para entrar a /admin/estado. Si está vacío, el panel queda deshabilitado.
ADMIN_TOKEN=""
# Secreto para /api/cron/* (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# ─── Email (alertas) ─────────────────────────────────────────────
# console | smtp | resend   ("console" imprime los mails en el log, para desarrollo)
EMAIL_PROVIDER="console"
EMAIL_FROM="PixelPeso <alertas@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
RESEND_API_KEY=""

# ─── Regiones ────────────────────────────────────────────────────
# Países que componen la región "Europa" (España tiene su propia columna)
EUROPA_PAISES="DE,FR,IT,PT,NL,PL,GB"

# ─── Fuentes de datos (los defaults están en config/fuentes.ts) ──
NINTENDO_PRICE_API_URL="https://api.ec.nintendo.com/v1/price"
NINTENDO_PRICE_MAX_IDS="50"
NINTENDO_EU_SEARCH_URL="https://searching.nintendo-europe.com"
NINTENDO_EU_ROWS="1000"
NINTENDO_ALGOLIA_APP_ID="U3B6GR4UA3"
NINTENDO_ALGOLIA_API_KEY="a29c6927638bfd8cee23993e51e721c9"
NINTENDO_ALGOLIA_INDEX="store_game_en_us"
DOLARAPI_URL="https://dolarapi.com"
DOLARAPI_EURO_BLUE_PATH="/v1/cotizaciones/eur/blue"
FRANKFURTER_URL="https://api.frankfurter.app"
INSTANT_GAMING_URL="https://www.instant-gaming.com"
# Proveedores de gift cards habilitados (separados por coma)
GIFTCARD_PROVEEDORES="instant-gaming,manual"

# ─── Scraping ────────────────────────────────────────────────────
SCRAPER_USER_AGENT="PixelPesoBot/1.0 (+https://github.com/0x0ar/eShop)"
SCRAPER_MIN_INTERVAL_MS="4000"
SCRAPER_CACHE_TTL_MS="43200000"
API_MIN_INTERVAL_MS="250"

# ─── Worker ──────────────────────────────────────────────────────
# Limita cuántos productos por catálogo se procesan (0 = todos). Útil para probar.
CATALOGO_LIMITE="0"
# Zona horaria de los cron del worker
TZ_WORKER="America/Argentina/Buenos_Aires"
# Expresiones cron (formato node-cron)
CRON_COTIZACIONES="*/30 * * * *"
CRON_PRECIOS="15 6,18 * * *"
CRON_CATALOGO="0 4 * * *"
CRON_SCRAPERS="30 5 * * *"
